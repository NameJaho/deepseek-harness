{
  "name": "@deepseek-ai/dsh-company-cloud-agent-runtime",
  "version": "0.2.1-alpha.3",
  "private": true,
  "description": "Scoped literal Cloud Agent prompts and release-scoped tool policies",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
