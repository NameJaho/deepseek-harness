// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`keeps direct knowledge retrieval out of authoring and exposes it to a release 1`] = `
{
  "prompt": "Literal {{not_an_expression}}

Approved knowledge sources: operations. Use cloud_knowledge before answering questions that need company knowledge. Cite document titles and sections. If no reliable evidence is returned, state what is missing rather than inventing an answer.",
  "tools": [
    {
      "description": "Search an approved company knowledge source. Use returned evidence and cite document titles and sections. An empty hit list is not evidence for an invented answer.",
      "name": "cloud_knowledge",
      "parameters": {
        "properties": {
          "emotion": {
            "description": "Optional current-user emotion: 平和, 疑惑, 着急, 不满 or 愤怒.",
            "type": "string",
          },
          "excludeNeedsReview": {
            "description": "Exclude document chunks awaiting review.",
            "type": "boolean",
          },
          "filterDocType": {
            "description": "Optional document type filter.",
            "type": "string",
          },
          "image": {
            "description": "Optional image URL, data URI or base64 for image retrieval.",
            "type": "string",
          },
          "kbIds": {
            "description": "Optional knowledge base ids within the approved source spaces.",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "messages": {
            "description": "Optional complete conversation history ending with the current user question.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "content": {
                  "type": "string",
                },
                "role": {
                  "enum": [
                    "user",
                    "assistant",
                  ],
                  "type": "string",
                },
              },
              "required": [
                "role",
                "content",
              ],
              "type": "object",
            },
            "type": "array",
          },
          "prevMethodId": {
            "description": "Method id from the previous retrieval response for a continuing issue.",
            "type": "string",
          },
          "query": {
            "description": "Current user question in natural language.",
            "type": "string",
          },
          "sourceId": {
            "description": "Exact approved knowledge source id.",
            "enum": [
              "operations",
            ],
            "type": "string",
          },
          "sources": {
            "description": "Optional retrieval source restriction.",
            "items": {
              "enum": [
                "chunks",
                "images",
                "im",
                "graph",
              ],
              "type": "string",
            },
            "type": "array",
          },
          "topK": {
            "description": "Optional result count per source, from 1 to 50.",
            "type": "number",
          },
          "verify": {
            "description": "Whether the retrieval service verifies sufficiency and supplements evidence; defaults to true.",
            "type": "boolean",
          },
        },
        "required": [
          "sourceId",
          "query",
        ],
        "type": "object",
      },
    },
  ],
}
`;
