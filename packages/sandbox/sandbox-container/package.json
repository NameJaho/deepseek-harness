  "version": "0.2.2-alpha.2",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sandbox/sandbox-container"
  },
  "type": "module",
  "main": "lib/index.js",
